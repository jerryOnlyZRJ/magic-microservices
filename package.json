{
  "name": "magic-microservices",
  "version": "1.0.0",
  "description": "Micro frontends made easy. Build with Web Components.",
  "private": true,
  "scripts": {
    "lint": "npm-run-all prettier eslint",
    "lint:fix": "npm-run-all prettier:fix eslint:fix",
    "prettier": "prettier './**/*.{ts,js,tsx,json,md}' --check",
    "prettier:fix": "prettier './**/*.{ts,js,tsx,json,md}' --write",
    "eslint": "eslint --ext .tsx,.js,.ts .",
    "eslint:fix": "eslint --ext .tsx,.js,.ts . --fix",
    "bootstrap": "lerna bootstrap",
    "build": "lerna run build",
    "clean": "lerna run clean && lerna clean -y",
    "publish": "npm run lint:fix && lerna publish --conventional-commits",
    "test": "lerna run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jerryOnlyZRJ/magic-microservices"
  },
  "keywords": ["magic", "microfrontends", "microservices", "web-components"],
  "author": {
    "name": "Ranjay Zheng",
    "email": "magic-microservices@bytedance.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "eslint": "^7.6.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-config-standard": "^14.1.1",
    "husky": "^2.3.0",
    "lerna": "^3.22.1",
    "lint-staged": "^10.5.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.2.1",
    "typescript": "^4.2.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": ["prettier --write", "eslint --fix"],
    "*.{json,md}": ["prettier --write"]
  }
}
